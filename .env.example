# ─────────────────────────────────────────────────────────────────────────────
# Namuna konfiguratsiya. Serverda nusxa oling:  cp .env.example .env.production
#
# MUHIM: bu o'zgaruvchilar RUNTIME'da (server ishga tushganda) o'qiladi.
# Shu sabab BITTA build'ni har xil serverga/kioskka qo'yib, faqat shu faylni
# o'zgartirib, serverni qayta ishga tushirish kifoya — qayta build SHART EMAS.
#
# NEXT_PUBLIC_ prefiksini ISHLATMANG — u qiymatni build paytida kodga muzlatadi.
# ─────────────────────────────────────────────────────────────────────────────

# Navbat backend URL (Go server)
API_URL=http://127.0.0.1:8085

# WebSocket URL (ixtiyoriy — bo'sh bo'lsa API_URL dan http->ws avtomatik olinadi)
# WS_URL=ws://127.0.0.1:8085

# Kiosk printer driver (har bir kioskda local)
PRINTER_URL=http://localhost:8080

# Printer API kaliti
PRINTER_API_KEY=CHANGE-ME
